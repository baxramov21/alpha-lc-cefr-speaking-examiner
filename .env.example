# ====================================================
# Supabase
# ====================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service role key — bypasses RLS. NEVER expose this in client code.
# Find it: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ====================================================
# Google Gemini
# ====================================================
GEMINI_API_KEY=your-gemini-api-key-here

# ====================================================
# Admin Authentication (REQUIRED — app will crash without these)
# ====================================================
# Generate a strong JWT secret: openssl rand -base64 48
JWT_SECRET=your-strong-random-jwt-secret-here

ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-strong-admin-password-here

# ====================================================
# Upstash Redis (for rate limiting — REQUIRED)
# Get free credentials at https://console.upstash.com/
# ====================================================
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-here
CRON_SECRET=my_secure_cron_key_123
